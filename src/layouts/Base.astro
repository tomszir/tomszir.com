---
import { Font } from 'astro:assets'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import { englishPath, langOf, localePath, t, translated } from '../i18n'
import { site } from '../site'
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
  /** A post's dates: the page is shared as an article. */
  article?: { published: Date; updated?: Date | undefined }
}

const lang = langOf(Astro.url.pathname)
const { title, description = site.description[lang], article } = Astro.props
const pageTitle = title ? `${title} · ${site.name}` : site.name
// Pages are built as files (`/cv.html`) but served without the extension, and the .html
// address redirects, so the canonical URL drops it.
const canonical = new URL(Astro.url.pathname.replace(/(\/?index)?\.html$/, '') || '/', Astro.site)
// Each page's preview card, from src/pages/og/; a 404 page shares its home page's.
const cardPath = canonical.pathname.slice(1).replace(/(^|\/)404$/, '')
const card = new URL(`/og/${cardPath || 'index'}.png`, Astro.site)
// A translated page names both versions, English as the default; English-only pages name none.
const english = englishPath(canonical.pathname)
const alternates = translated.includes(english)
  ? [
      { hreflang: 'en', href: new URL(english, Astro.site) },
      { hreflang: 'lv', href: new URL(localePath('lv', english), Astro.site) },
      { hreflang: 'x-default', href: new URL(english, Astro.site) },
    ]
  : []
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />
    {alternates.map((link) => <link rel="alternate" hreflang={link.hreflang} href={link.href} />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name}: writing`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f7f7f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0b0a" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={card} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    {
      article && (
        <meta property="article:published_time" content={article.published.toISOString()} />
      )
    }
    {
      article?.updated && (
        <meta property="article:modified_time" content={article.updated.toISOString()} />
      )
    }
    <script is:inline>
      // Runs before first paint, so a stored or system dark theme never flashes light.
      ;(() => {
        const root = document.documentElement
        let theme = null
        try {
          theme = localStorage.getItem('theme')
        } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
        }
        root.dataset.theme = theme
        try {
          if (!sessionStorage.getItem('intro')) {
            root.dataset.intro = ''
            sessionStorage.setItem('intro', '1')
          }
        } catch {}
      })()
    </script>
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" preload />
    <slot name="head" />
  </head>
  <body>
    <a class="skip meta" href="#content">{t(lang).skip}</a>
    <Header />
    <main id="content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/clock'
      import '../scripts/sun'
      import '../scripts/glide'
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: var(--gutter);
    top: 8px;
    z-index: 20;
    padding: 12px 14px;
    background: var(--fg);
    color: var(--bg);
    transform: translateY(-200%);
  }

  .skip:focus-visible {
    transform: none;
  }

  main:focus {
    outline: none;
  }
</style>
