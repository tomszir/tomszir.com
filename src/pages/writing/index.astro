---
import PostList from '../../components/PostList.astro'
import Base from '../../layouts/Base.astro'
import { getPosts } from '../../lib/posts'
import { site } from '../../site'

const posts = await getPosts()
---

<Base {...site.pages.writing}>
  <div class="container">
    <header class="page-head">
      <h1 class="page-title" style={{ viewTransitionName: 'page-writing' }}>Writing</h1>
      <p class="lede">
        Notes and essays on building software. {posts.length === 1 ? '1 post' : `${posts.length} posts`}
        so far.
      </p>
      <a class="back" href="/rss.xml">RSS feed</a>
    </header>
    <PostList posts={posts} />
  </div>
</Base>
