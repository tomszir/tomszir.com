---
import { render } from 'astro:content'
import type { GetStaticPaths } from 'astro'
import Article from '../../components/Article.astro'
import Icon from '../../components/Icon.astro'
import Base from '../../layouts/Base.astro'
import { formatDate, getPosts, type Post, readingMinutes } from '../../lib/posts'

export const getStaticPaths = (async () => {
  const posts = await getPosts()
  // Newest first, so the next post is the older one.
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: { post, newer: posts[index - 1], older: posts[index + 1] },
  }))
}) satisfies GetStaticPaths

interface Props {
  post: Post
  newer: Post | undefined
  older: Post | undefined
}

const { post, newer, older } = Astro.props
const { Content, headings } = await render(post)
const { title, description, published, updated } = post.data
---

<Base title={title} description={description} article={{ published, updated }}>
  <div class="progress" aria-hidden="true" data-progress hidden></div>
  <article class="container">
    <header class="page-head">
      <a class="back" href="/writing">Writing</a>
      <h1 class="page-title" style={{ viewTransitionName: `post-${post.id}` }}>{title}</h1>
      <p class="meta muted">
        <time datetime={published.toISOString()}>{formatDate(published)}</time>
        {
          updated && (
            <>
              {' · updated '}
              <time datetime={updated.toISOString()}>{formatDate(updated)}</time>
            </>
          )
        }
        {` · ${readingMinutes(post)} min`}
      </p>
    </header>
    <Article headings={headings} minutes={readingMinutes(post)}>
      <Content />
    </Article>
    {
      (newer || older) && (
        <nav class="section" aria-label="More writing">
          <span class="section-label">More</span>
          <div class="more">
            {older && (
              <a class="panel" href={`/writing/${older.id}`}>
                <span class="meta muted">Previous</span>
                <Icon name="arrow-right" size={16} class="panel-arrow" />
                <span class="title">{older.data.title}</span>
              </a>
            )}
            {newer && (
              <a class="panel" href={`/writing/${newer.id}`}>
                <span class="meta muted">Next</span>
                <Icon name="arrow-right" size={16} class="panel-arrow" />
                <span class="title">{newer.data.title}</span>
              </a>
            )}
          </div>
        </nav>
      )
    }
  </article>
</Base>

<script>
  // The reading-progress line: how far through the post's text the reader is, full when its last
  // line reaches the bottom of the viewport. Without the script the line stays hidden.
  const bar = document.querySelector<HTMLElement>('[data-progress]')
  const prose = document.querySelector<HTMLElement>('.prose')

  if (bar && prose) {
    let ticking = false
    const update = () => {
      ticking = false
      const end = prose.getBoundingClientRect().bottom + scrollY - innerHeight
      const progress = end > 0 ? Math.min(1, Math.max(0, scrollY / end)) : 1
      bar.style.setProperty('--progress', String(progress))
    }

    addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true
          requestAnimationFrame(update)
        }
      },
      { passive: true },
    )
    addEventListener('resize', update)
    update()
    bar.hidden = false
  }
</script>

<style>
  .page-title {
    max-width: 20ch;
  }

  .more {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 12px;
  }

  .more .title {
    padding-right: 28px;
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  /* The reading-progress line, set by the script above. */
  .progress {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: 2px;
    background: var(--accent);
    transform: scaleX(var(--progress, 0));
    transform-origin: 0 50%;
  }
</style>
