---
import Icon from '../../components/Icon.astro'
import JsonLd from '../../components/JsonLd.astro'
import PostList from '../../components/PostList.astro'
import ProductPanel from '../../components/ProductPanel.astro'
import { langOf, langPaths, localePath, t } from '../../i18n'
import Base from '../../layouts/Base.astro'
import { formatDate, getPosts, readingMinutes } from '../../lib/posts'
import { getProducts } from '../../lib/products'
import { personData } from '../../lib/structured-data'
import { site } from '../../site'

export const getStaticPaths = langPaths

const lang = langOf(Astro.url.pathname)
const text = t(lang)
const [posts, products] = await Promise.all([getPosts(), getProducts()])
const [latest] = posts
const [main, side] = products
const { availability } = site
---

<Base>
  <JsonLd slot="head" data={personData(lang)} />
  <div class="container">
    <section class="hero" aria-labelledby="name">
      <h1 id="name" class="name">
        <span class="line"><span>{site.name}<span class="stop" aria-hidden="true"></span></span></span>
      </h1>
      <p class="lede intro">{text.intro}</p>
    </section>

    <section class="now" aria-label={text.now.label}>
      {
        availability.open && (
          <a class="panel availability" href={localePath(lang, '/cv')}>
            <span class="meta label">{text.availability.label}</span>
            <Icon name="arrow-right" size={16} class="panel-arrow" />
            <span class="value-large">{text.availability.open}</span>
            <dl class="meta">
              <div>
                <dt>{text.availability.roles}</dt>
                <dd>{availability.roles[lang]}</dd>
              </div>
              <div>
                <dt>{text.availability.where}</dt>
                <dd>{availability.where[lang]}</dd>
              </div>
              <div>
                <dt>{text.availability.from}</dt>
                <dd>{availability.from[lang]}</dd>
              </div>
            </dl>
          </a>
        )
      }
      {main && <ProductPanel product={main} label={text.now.building} />}
      {side && <ProductPanel product={side} label={text.now.side} />}
      {
        latest ? (
          <a
            class="panel"
            href={`/writing/${latest.id}`}
            hreflang={lang === 'en' ? undefined : 'en'}
          >
            <span class="meta muted">{text.now.latest}</span>
            <Icon name="arrow-right" size={16} class="panel-arrow" />
            <span class="value">
              <span class="value-small">
                {lang === 'en' ? (
                  latest.data.title
                ) : (
                  <>
                    <span lang="en">{latest.data.title}</span>{' '}
                    <span class="meta muted">{text.english}</span>
                  </>
                )}
              </span>
              <span class="meta muted">
                {formatDate(latest.data.published)} · {readingMinutes(latest)} min
              </span>
            </span>
          </a>
        ) : (
          <a class="panel" href={localePath(lang, '/writing')}>
            <span class="meta muted">{text.now.latest}</span>
            <Icon name="arrow-right" size={16} class="panel-arrow" />
            <span class="value">
              <span class="value-small">{text.now.firstPost}</span>
              <span class="meta muted">{text.now.subscribe}</span>
            </span>
          </a>
        )
      }
      <div class="panel">
        <span class="meta muted">{text.now.time}</span>
        <span class="value">
          <span class="value-large">
            <time data-clock={site.timeZone} hidden></time><noscript>{site.place[lang]}</noscript>
          </span>
          <span class="meta muted">
            Europe/Riga{' '}
            <span data-sun-wrap hidden>
              {`· ${text.now.sun} `}<span data-sun></span>{'° '}<span
                data-sun-word
                data-above={text.now.above}
                data-below={text.now.below}
              ></span>
            </span>
          </span>
        </span>
      </div>
      <div class="panel">
        <span class="meta muted">{text.now.page}</span>
        <span class="value">
          <span class="value-large">
            <data data-build="page-kb" value="">–</data><span class="meta muted unit">
              {text.now.budget}</span
            >
          </span>
          <span class="bar" aria-hidden="true"
            ><span class="bar-fill" data-build-fill style="--fill: 0%"></span></span
          >
        </span>
      </div>
      <div class="panel">
        <span class="meta muted">{text.now.build}</span>
        <span class="value">
          <span class="value-large"><data data-build="date" value="">–</data></span>
          <span class="meta muted"
            >{text.now.from} <a class="link commit" href={`${site.source}/commits/main`} data-build-link="commit"
              ><data data-build="commit" value="">–</data></a
            ></span
          >
        </span>
      </div>
    </section>

    <section class="section" aria-labelledby="writing">
      <h2 id="writing" class="section-label">{text.nav.writing}</h2>
      <div class="writing">
        <PostList posts={posts.slice(0, 3)} />
        {
          posts.length > 0 && (
            <a class="back all" href={localePath(lang, '/writing')}>
              {posts.length > 3 ? `${text.allWriting} (${posts.length})` : text.allWriting}
              <Icon name="arrow-right" />
            </a>
          )
        }
      </div>
    </section>
  </div>
</Base>

<style>
  .hero {
    display: grid;
    gap: 24px;
    padding-block: clamp(80px, 11vw, 144px) 64px;
  }

  .name {
    font-size: var(--step-display);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 0.95;
  }

  .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
  }

  .line > span {
    display: inline-block;
  }

  /* The full stop as the mark's accent square, sat on the baseline. */
  .stop {
    display: inline-block;
    width: 0.15em;
    height: 0.15em;
    margin-left: 0.04em;
    background: var(--accent);
  }

  /* Once per session the name rises out of its mask, then the introduction follows. */
  :global(:root[data-intro]) .line > span {
    animation: rise 0.9s var(--ease) both;
  }

  :global(:root[data-intro]) .intro {
    animation: appear 0.8s ease 250ms both;
  }

  @keyframes rise {
    from {
      transform: translateY(100%);
    }
  }

  @keyframes appear {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  .now {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .now > :global(*) {
    min-height: 184px;
  }

  @media (max-width: 1100px) {
    .now {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .now {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Inverted: the one surface that takes the text colour as its ground. It spans the row above the
     other panels, so they keep their grid whether it's there or not. */
  .availability {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 24px 32px;
    min-height: 0;
    background: var(--fg);
    color: var(--bg);
  }

  a.availability:is(:hover, :focus-visible, :active) {
    background: color-mix(in srgb, var(--fg) 92%, var(--bg));
  }

  .availability .label,
  .availability dt,
  .availability :global(.panel-arrow) {
    color: color-mix(in srgb, var(--bg) 66%, var(--fg));
  }

  .availability .label {
    grid-column: 1 / -1;
  }

  .availability dl {
    display: grid;
    gap: 2px;
  }

  .availability dl div {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    gap: 12px;
  }

  .availability dd {
    font-family: var(--font-sans);
    font-size: 14px;
  }

  @media (max-width: 600px) {
    .availability {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .value {
    display: grid;
    gap: 8px;
    padding-right: 28px;
  }

  .value-large {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    font-size: 40px;
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.05;
    font-variant-numeric: tabular-nums;
  }

  .value-small {
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .unit {
    letter-spacing: 0;
  }

  .commit {
    color: var(--fg);
  }

  .bar {
    display: block;
    height: 4px;
    margin-top: 6px;
    border-radius: 4px;
    background: var(--raised);
    overflow: hidden;
  }

  .bar-fill {
    display: block;
    width: var(--fill);
    height: 100%;
    border-radius: 4px;
    background: var(--accent);
  }



  .writing {
    display: grid;
    gap: 8px;
  }

  .all {
    margin-top: 4px;
  }
</style>
