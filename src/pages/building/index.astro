---
import ProductPanel from '../../components/ProductPanel.astro'
import Base from '../../layouts/Base.astro'
import { getProducts } from '../../lib/products'
import { site } from '../../site'

const products = await getProducts()
---

<Base {...site.pages.building}>
  <div class="container">
    <header class="page-head">
      <h1 class="page-title" style={{ viewTransitionName: 'page-building' }}>Building</h1>
      <p class="lede">What I'm working on now, with the people I work with and on my own.</p>
    </header>
    <div class="grid">
      {products.map((product) => <ProductPanel product={product} label={product.data.with} />)}
    </div>
  </div>
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  @media (max-width: 760px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
