---
import type { MarkdownHeading } from 'astro'
import Icon from './Icon.astro'
// The blocks write-ups import from MDX. Imported here too so their styles join the page's own and
// get hashed into its Content-Security-Policy; from MDX alone they arrive too late and are blocked.
import './write-up/Decision.astro'
import './write-up/Flow.astro'
import './write-up/Note.astro'

interface Props {
  headings: MarkdownHeading[]
  minutes: number
}

const { headings, minutes } = Astro.props
const sections = headings.filter((heading) => heading.depth === 2)
---

<div class:list={['article', { 'has-contents': sections.length >= 2 }]}>
  {
    sections.length >= 2 && (
      <nav class="contents" aria-label="On this page">
        <ol data-glide>
          {sections.map((section) => (
            <li>
              <a href={`#${section.slug}`} data-contents-link data-glide-item>
                <span class="marker" aria-hidden="true" />
                {section.text}
              </a>
            </li>
          ))}
        </ol>
        <p class="meta muted minutes">{minutes} min read</p>
      </nav>
    )
  }
  <div class="prose">
    <slot />
  </div>
</div>

<template id="copy-icons">
  <Icon name="copy" class="when-idle" />
  <Icon name="check" class="when-copied" />
</template>

<script>
  // The contents entry for the section being read gets aria-current and the accent marker: the
  // last heading above a line 30% down the viewport. Short sections at the end never reach that
  // line, so over the last stretch of scrolling the line slides down to the bottom edge, and each
  // remaining heading becomes current in order, the last one when the page ends.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-contents-link]')]
  const sections = links.flatMap((link) => {
    const heading = document.getElementById(decodeURIComponent(link.hash.slice(1)))
    return heading ? [{ link, heading }] : []
  })

  if (sections.length > 0) {
    let pinned: HTMLAnchorElement | null = null
    let ticking = false

    const mark = (current: HTMLAnchorElement) => {
      for (const { link } of sections) {
        if (link === current) link.setAttribute('aria-current', 'location')
        else link.removeAttribute('aria-current')
      }
    }

    const update = () => {
      ticking = false
      if (pinned) return
      const rest = innerHeight * 0.7
      const maxScroll = document.documentElement.scrollHeight - innerHeight
      const progress = Math.min(1, Math.max(0, (scrollY - (maxScroll - rest)) / rest))
      const line = innerHeight * 0.3 + rest * progress - 1
      const passed = sections.filter(({ heading }) => heading.getBoundingClientRect().top <= line)
      const current = passed.at(-1) ?? sections[0]
      if (current) mark(current.link)
    }

    addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true
          requestAnimationFrame(update)
        }
      },
      { passive: true },
    )
    addEventListener('resize', update)

    // A clicked entry is current even if its heading can't scroll to the line; the next scroll
    // the reader makes themselves releases it.
    for (const { link } of sections) {
      link.addEventListener('click', () => {
        pinned = link
        mark(link)
        const release = () => {
          pinned = null
          removeEventListener('wheel', release)
          removeEventListener('touchmove', release)
          removeEventListener('keydown', release)
        }
        addEventListener('wheel', release, { passive: true })
        addEventListener('touchmove', release, { passive: true })
        addEventListener('keydown', release)
      })
    }

    update()
  }

  // Each code block gets a copy button, announced to screen readers when it works.
  const icons = document.querySelector<HTMLTemplateElement>('#copy-icons')
  if (icons && navigator.clipboard) {
    for (const pre of document.querySelectorAll<HTMLPreElement>('.prose pre')) {
      const wrap = document.createElement('div')
      wrap.className = 'code'
      pre.replaceWith(wrap)
      wrap.append(pre)

      const button = document.createElement('button')
      button.type = 'button'
      button.className = 'copy button'
      button.append(icons.content.cloneNode(true))
      const label = document.createElement('span')
      label.textContent = 'Copy'
      button.append(label)
      const status = document.createElement('span')
      status.className = 'sr-only'
      status.setAttribute('aria-live', 'polite')
      wrap.append(button, status)

      let reset: number | undefined
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(pre.innerText)
        } catch {
          return
        }
        label.textContent = 'Copied'
        button.dataset.copied = ''
        status.textContent = 'Code copied'
        clearTimeout(reset)
        reset = window.setTimeout(() => {
          label.textContent = 'Copy'
          delete button.dataset.copied
          status.textContent = ''
        }, 1600)
      })
    }
  }
</script>

<style>
  .article.has-contents {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 48px;
  }

  .contents {
    position: sticky;
    top: 96px;
    align-self: start;
  }

  .contents ol {
    display: grid;
  }

  .contents a {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    margin-left: -12px;
    padding: 6px 12px;
    border-radius: var(--radius-row);
    font-size: 15px;
    line-height: 1.3;
    color: var(--muted);
    transition: color 0.2s ease;
  }

  .contents a:hover,
  .contents a[aria-current] {
    color: var(--fg);
  }

  .marker {
    flex: none;
    width: 6px;
    height: 6px;
    background: transparent;
    transition: background-color 0.25s ease;
  }

  .contents a[aria-current] .marker {
    background: var(--accent);
  }

  .minutes {
    padding-top: 12px;
  }

  @media (max-width: 960px) {
    .article.has-contents {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }

    .contents {
      position: static;
      padding: 12px 20px;
      border-radius: var(--radius-panel);
      background: var(--panel);
    }

    .contents a {
      margin-left: 0;
      padding-inline: 0;
    }

    .contents :global(.glide-band) {
      display: none;
    }
  }

  .prose :global(.code) {
    position: relative;
  }

  .prose :global(.copy) {
    position: absolute;
    top: 10px;
    right: 10px;
    min-height: 44px;
    padding: 0 14px;
    background: var(--raised);
    font-size: 13px;
    opacity: 0;
    transition:
      opacity 0.2s ease,
      background-color 0.2s ease;
  }

  .prose :global(.code:hover .copy),
  .prose :global(.copy:focus-visible),
  .prose :global(.copy[data-copied]) {
    opacity: 1;
  }

  @media (hover: none) {
    .prose :global(.copy) {
      opacity: 1;
    }
  }

  .prose :global(.copy .when-copied),
  .prose :global(.copy[data-copied] .when-idle) {
    display: none;
  }

  .prose :global(.copy[data-copied] .when-copied) {
    display: inline-flex;
  }
</style>
