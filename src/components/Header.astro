---
import { langOf, localePath, t } from '../i18n'
import { site } from '../site'
import Icon from './Icon.astro'
import LanguageSwitch from './LanguageSwitch.astro'
import ThemeToggle from './ThemeToggle.astro'

// With file output the build sees `/building.html`, the dev server `/building`.
const path = Astro.url.pathname.replace(/\.html$/, '')
const lang = langOf(path)
const text = t(lang)
const links = (['building', 'writing', 'cv', 'contact'] as const)
  .map((page) => ({ href: localePath(lang, `/${page}`), label: text.nav[page] }))
  .map((link) => ({
    ...link,
    current: path === link.href || path.startsWith(`${link.href}/`),
  }))
---

<header class="site-header no-print" data-header>
  <div class="container bar">
    <div class="start">
      <a class="mark" href={localePath(lang, '/')} aria-label={`${site.name}, ${text.home}`}>
        <span class="square" aria-hidden="true"></span>tomszir
      </a>
    </div>
    <div class="end">
      <nav class="links" aria-label={text.primary} data-nav>
        <span class="pill" aria-hidden="true" data-pill></span>
        <ul>
          {
            links.map((link) => (
              <li>
                <a href={link.href} aria-current={link.current ? 'page' : undefined} data-nav-link>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <button
        class="search-button button"
        type="button"
        aria-label={text.search}
        aria-keyshortcuts="Control+K Meta+K /"
        data-search-button
        hidden
      >
        <kbd data-search-shortcut>Ctrl K</kbd>
      </button>
      <LanguageSwitch />
      <ThemeToggle />
      <button
        class="menu-button button"
        type="button"
        aria-expanded="false"
        aria-controls="menu"
        data-menu-button
        data-label-open={text.close}
        data-label-closed={text.menu}
        hidden
      >
        <Icon name="menu" class="when-closed" />
        <Icon name="x" class="when-open" />
        <span data-menu-label>{text.menu}</span>
      </button>
    </div>
  </div>

  <div class="menu" id="menu" data-menu hidden>
    <nav class="container" aria-label={text.menu}>
      <ol>
        {
          links.map((link, index) => (
            <li style={{ '--i': index }}>
              <a class="panel" href={link.href} aria-current={link.current ? 'page' : undefined}>
                <span class="menu-title">{link.label}</span>
                <Icon name="arrow-right" size={18} class="panel-arrow" />
              </a>
            </li>
          ))
        }
        <li class="menu-search" style={{ '--i': links.length }} data-search-item hidden>
          <button class="panel" type="button" data-search-button>
            <span class="menu-title">{text.search}</span>
            <Icon name="arrow-right" size={18} class="panel-arrow" />
          </button>
        </li>
      </ol>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')
  const button = document.querySelector<HTMLButtonElement>('[data-menu-button]')
  const menu = document.querySelector<HTMLElement>('[data-menu]')

  if (header && button && menu) {
    // Hide while reading down the page; return on any scroll up, near the top, or on focus.
    let lastY = scrollY
    let ticking = false
    const onScroll = () => {
      const y = scrollY
      if (!header.matches(':focus-within') && !header.hasAttribute('data-menu-open')) {
        if (y > 80 && y - lastY > 8) header.dataset.hidden = ''
        else if (y < lastY || y <= 80) delete header.dataset.hidden
      }
      if (Math.abs(y - lastY) > 8 || y <= 80) lastY = y
      header.toggleAttribute('data-scrolled', y > 0)
      ticking = false
    }
    addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true
          requestAnimationFrame(onScroll)
        }
      },
      { passive: true },
    )
    header.addEventListener('focusin', () => delete header.dataset.hidden)

    // The phone menu. Everything outside the header is inert while it's open.
    const outside = () =>
      [...document.body.children].filter(
        (el): el is HTMLElement => el instanceof HTMLElement && el !== header,
      )

    const setOpen = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open))
      const label = button.querySelector('[data-menu-label]')
      if (label) label.textContent = (open ? button.dataset.labelOpen : button.dataset.labelClosed) ?? ''
      header.toggleAttribute('data-menu-open', open)
      document.documentElement.toggleAttribute('data-menu-open', open)
      for (const el of outside()) el.inert = open
      menu.hidden = !open
      if (open) {
        delete header.dataset.hidden
        menu.querySelector('a')?.focus()
      } else {
        button.focus()
      }
    }

    button.hidden = false
    header.dataset.menuReady = ''
    button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'))
    addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && header.hasAttribute('data-menu-open')) setOpen(false)
    })
    matchMedia('(min-width: 821px)').addEventListener('change', (event) => {
      if (event.matches && header.hasAttribute('data-menu-open')) setOpen(false)
    })
  }

  // The command menu: Ctrl K or Cmd K anywhere, / outside text fields, or a search button. Its code
  // and index load on first open (src/scripts/command-menu.ts).
  const searchButtons = document.querySelectorAll<HTMLButtonElement>('[data-search-button]')
  const shortcut = document.querySelector('[data-search-shortcut]')
  if (shortcut && /Mac|iPhone|iPad/.test(navigator.userAgent)) shortcut.textContent = '⌘ K'

  const openMenu = async () => {
    if (header?.hasAttribute('data-menu-open')) button?.click()
    // Kept out of Vite's graph on purpose; see src/pages/command-menu.js.ts.
    const script = '/command-menu.js'
    const commandMenu: typeof import('../scripts/command-menu') = await import(
      /* @vite-ignore */ script
    )
    commandMenu.openMenu()
  }
  const typing = (target: EventTarget | null) =>
    target instanceof HTMLElement &&
    (target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName))

  addEventListener('keydown', (event) => {
    if (event.key.toLowerCase() === 'k' && (event.metaKey || event.ctrlKey) && !event.altKey) {
      event.preventDefault()
      openMenu()
    } else if (event.key === '/' && !event.metaKey && !event.ctrlKey && !typing(event.target)) {
      event.preventDefault()
      openMenu()
    }
  })
  for (const searchButton of searchButtons) {
    searchButton.addEventListener('click', openMenu)
    searchButton.hidden = false
  }
  document.querySelector<HTMLElement>('[data-search-item]')?.removeAttribute('hidden')

  // The nav's highlight: one pill that rests under the current page and slides to the link under
  // the pointer or focus, then back on leaving. Where no link is current it appears at the link
  // rather than sliding in, and fades out on leaving.
  const nav = document.querySelector<HTMLElement>('[data-nav]')
  const pill = nav?.querySelector<HTMLElement>('[data-pill]')

  if (nav && pill) {
    const navLinks = [...nav.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')]
    const current = navLinks.find((link) => link.getAttribute('aria-current') === 'page')

    const put = (link: HTMLElement) => {
      pill.style.setProperty('--x', `${link.offsetLeft}px`)
      pill.style.setProperty('--w', `${link.offsetWidth}px`)
    }

    const jump = (link: HTMLElement) => {
      pill.dataset.jump = ''
      put(link)
      pill.getBoundingClientRect()
      delete pill.dataset.jump
    }

    const rest = () => {
      if (current) put(current)
      else delete pill.dataset.on
    }

    for (const link of navLinks) {
      const enter = () => {
        if (pill.hasAttribute('data-on')) put(link)
        else jump(link)
        pill.dataset.on = ''
      }
      link.addEventListener('pointerenter', enter)
      link.addEventListener('focus', enter)
    }
    nav.addEventListener('pointerleave', () => {
      if (!nav.contains(document.activeElement)) rest()
    })
    nav.addEventListener('focusout', (event) => {
      if (!(event.relatedTarget instanceof Node && nav.contains(event.relatedTarget))) rest()
    })

    const place = () => {
      if (!current) return
      jump(current)
      pill.dataset.on = ''
    }
    addEventListener('resize', place)
    document.fonts?.ready.then(place)
    place()
    nav.dataset.pillReady = ''
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--bg);
    transition: transform 0.45s var(--ease);
  }

  .site-header[data-hidden] {
    transform: translateY(-100%);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
    min-height: 72px;
  }

  .start,
  .end {
    display: flex;
    align-items: center;
    gap: 8px 20px;
    min-width: 0;
  }

  .end {
    justify-content: flex-end;
    gap: 8px;
  }

  /* Without JavaScript the links stay in the bar on a narrow screen, so the controls wrap below. */
  .site-header:not([data-menu-ready]) .end {
    flex-wrap: wrap;
  }

  .mark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 500;
  }

  .square {
    width: 10px;
    height: 10px;
    background: var(--accent);
    view-transition-name: mark;
  }

  .links {
    position: relative;
    isolation: isolate;
  }

  .links ul {
    position: relative;
    display: flex;
  }

  .pill {
    position: absolute;
    top: 0;
    left: 0;
    z-index: -1;
    width: var(--w, 0px);
    height: 100%;
    border-radius: var(--radius-control);
    background: var(--panel);
    opacity: 0;
    transform: translateX(var(--x, 0));
    transition:
      transform 0.45s var(--ease),
      width 0.45s var(--ease),
      opacity 0.25s ease;
    pointer-events: none;
  }

  .pill[data-on] {
    opacity: 1;
  }

  .pill[data-jump] {
    transition: none;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0 12px;
    border-radius: var(--radius-control);
    font-size: 15px;
    color: var(--muted);
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .links a:hover,
  .links a[aria-current='page'] {
    color: var(--fg);
  }

  /* Without the script, plain backgrounds stand in for the pill. */
  .links:not([data-pill-ready]) a[aria-current='page'],
  .links:not([data-pill-ready]) a:hover {
    background: var(--panel);
  }

  .menu-button :global(.when-open),
  .site-header[data-menu-open] .menu-button :global(.when-closed) {
    display: none;
  }

  .site-header[data-menu-open] .menu-button :global(.when-open) {
    display: inline-flex;
  }

  .search-button {
    padding: 0 12px;
  }

  .search-button kbd {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--muted);
  }

  .search-button[hidden],
  .menu-search[hidden] {
    display: none;
  }

  .menu .panel:is(button) {
    width: 100%;
    border: 0;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .menu-button[hidden] {
    display: none;
  }

  /* The phone menu: the four pages as panels, full screen. */
  .menu {
    position: fixed;
    inset: 72px 0 0;
    overflow-y: auto;
    background: var(--bg);
  }

  .menu[hidden] {
    display: none;
  }

  .menu ol {
    display: grid;
    gap: 8px;
    padding-top: 8px;
  }

  .menu li {
    animation: enter 0.45s var(--ease) both;
    animation-delay: calc(var(--i) * 40ms);
  }

  .menu .panel {
    flex-direction: row;
    align-items: center;
    min-height: 76px;
  }

  .menu .panel :global(.panel-arrow) {
    top: auto;
    opacity: 1;
    transform: none;
  }

  .menu a[aria-current='page'] {
    background: var(--raised);
  }

  .menu-title {
    font-size: 30px;
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  @keyframes enter {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  @media (max-width: 820px) {
    .site-header[data-menu-ready] .links {
      display: none;
    }

    .site-header[data-menu-ready] .search-button {
      display: none;
    }
  }

  @media (min-width: 821px) {
    .menu-button {
      display: none;
    }
  }
</style>
