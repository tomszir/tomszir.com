---
/**
 * The picture viewer for the gallery it sits in: `[data-viewer]` holding `[data-viewer-item]`
 * links to each picture's full size. Each side button is a box well past its chip, which sits in
 * the middle. The markup is here so it can use the site's icons; the
 * slides, behaviour and styles come with `/lightbox.js` (src/scripts/lightbox.ts). Without
 * JavaScript the dialog never opens and each link opens its picture.
 */
import Icon from './Icon.astro'
---

<dialog class="lightbox" aria-label="Pictures" data-lightbox>
  <figure class="lightbox-figure">
    <div class="lightbox-holder">
      <div class="lightbox-frame" data-frame>
        <div class="lightbox-window" data-window>
          <div class="lightbox-track" data-track></div>
        </div>
        <button class="lightbox-control lightbox-close" type="button" aria-label="Close" data-close>
          <Icon name="x" size={18} />
        </button>
        <span class="lightbox-control lightbox-count" aria-live="polite" data-count></span>
      </div>
      <button
        class="lightbox-side lightbox-previous"
        type="button"
        aria-label="Previous picture"
        data-previous
      >
        <span class="lightbox-control"><Icon name="arrow-right" size={18} /></span>
      </button>
      <button class="lightbox-side lightbox-next" type="button" aria-label="Next picture" data-next>
        <span class="lightbox-control"><Icon name="arrow-right" size={18} /></span>
      </button>
    </div>
    <figcaption class="lightbox-caption" data-caption></figcaption>
  </figure>
</dialog>
<script is:inline type="module" src="/lightbox.js"></script>
