---
import { langOf, t } from '../i18n'
import { formatDate, type Post, readingMinutes } from '../lib/posts'
import Icon from './Icon.astro'

interface Props {
  posts: Post[]
}

const { posts } = Astro.props
const lang = langOf(Astro.url.pathname)
const text = t(lang)
---

{
  posts.length > 0 ? (
    <ol data-glide>
      {posts.map((post) => (
        <li>
          <a
            class="row"
            href={`/writing/${post.id}`}
            hreflang={lang === 'en' ? undefined : 'en'}
            data-glide-item
          >
            <span class="row-title" style={{ viewTransitionName: `post-${post.id}` }}>
              {lang === 'en' ? (
                post.data.title
              ) : (
                <>
                  <span lang="en">{post.data.title}</span>{' '}
                  <span class="meta muted">{text.english}</span>
                </>
              )}
            </span>
            <span class="meta muted">
              <time datetime={post.data.published.toISOString()}>
                {formatDate(post.data.published)}
              </time>
              {` · ${readingMinutes(post)} min`}
            </span>
            <span class="row-note" lang={lang === 'en' ? undefined : 'en'}>
              {post.data.description}
            </span>
          </a>
        </li>
      ))}
    </ol>
  ) : (
    <div class="panel empty">
      <p>
        {text.empty.nothing} <span class="muted">{text.empty.onItsWay}</span>
      </p>
      <a class="button" href="/rss.xml">
        <Icon name="rss" />
        {text.empty.rss}
      </a>
    </div>
  )
}

<style>
  .empty {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font-size: 19px;
  }
</style>
