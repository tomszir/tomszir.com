---
/** An icon from src/icons/ (vendored by `mise run icons:vendor`), inlined and decorative. */
const icons = import.meta.glob<string>('../icons/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
})

interface Props {
  name: string
  size?: number
  class?: string
}

const { name, size = 16, class: className } = Astro.props
const svg = icons[`../icons/${name}.svg`]
if (!svg) throw new Error(`No icon "${name}" in src/icons; add it to vendor/icons.lock.json`)
// Inline SVG in HTML needs no namespace, and `focusable` only ever mattered to IE.
const sized = svg
  .replace(' xmlns="http://www.w3.org/2000/svg"', '')
  .replace('<svg ', `<svg width="${size}" height="${size}" aria-hidden="true" `)
---

<span class:list={['icon', className]} set:html={sized} />

<style>
  .icon {
    display: inline-flex;
    flex: none;
  }
</style>
