  "snippets": {
    "mika": {
      "source": "<html>\n<head>\n<title>Mika's corner</title>\n<meta name=\"viewport\" content=\"width=device-width\">\n<script src=\"analytics.js\"></script>\n</head>\n<body bgcolor=\"#10183a\" text=\"#f0f0f0\"\n  link=\"#ffcc33\" vlink=\"#ff9966\">\n<header>\n  <h1 style=\"display: flex; gap: 12px; color: #ffcc33\">\n    <img src=\"pigeon.png\" width=\"48\" height=\"48\" alt=\"\"\n      loading=\"lazy\">\n    Mika's corner\n  </h1>\n</header>\n<nav>\n  <a href=\"pigeon://mika/links\">Links</a> |\n  <a href=\"pigeon://mika/guestbook\">Guestbook</a>\n</nav>\n<div style=\"border-radius: 16px; box-shadow: 0 8px 24px #000;\n  background-color: #1c2a5c; padding: 12px\">\n  <font face=\"Verdana\" size=\"2\">\n    <p>Welcome to my corner of the Pigeonweb!\n    <a href=\"javascript:like()\">Like this page</a></p>\n    <picture><source srcset=\"pigeon.png\"><img src=\"pigeon.png\" alt=\"My pigeon\"></picture>\n    <p><svg width=\"12\" height=\"12\"><circle cx=\"6\" cy=\"6\" r=\"6\"/></svg>\n      Now playing: nothing</p>\n  </font>\n</div>\n<div style=\"position: fixed; bottom: 0; z-index: 9999;\n  background-color: #ffffff; color: #000000\">\n  Sign up for my newsletter\n</div>\n<marquee scrollamount=\"3\">\n  <font color=\"#66ff66\">Under construction since 2003</font>\n</marquee>\n</body>\n</html>\n",
